{
  "name": "bank-tdd-lab",
  "version": "1.0.0",
  "description": "Laboratório de TDD - aplicação bancária",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --runInBand",
    "typecheck": "tsc --noEmit",
    "build:ts": "tsc -p tsconfig.build.json",
    "test:bdd": "cucumber-js",
    "test:bdd:dry": "cucumber-js --dry-run",
    "test:bdd:full": "cucumber-js && node scripts/verificar-bdd.cjs",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:headed": "playwright test --project=chromium --headed",
    "test:e2e:report": "playwright show-report",
    "typecheck:k6": "tsc -p tsconfig.k6.json",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env.local scripts/db/seed.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joaovictorino/cleanarch-automated-tests-agents.git"
  },
  "bugs": {
    "url": "https://github.com/joaovictorino/cleanarch-automated-tests-agents/issues"
  },
  "homepage": "https://github.com/joaovictorino/cleanarch-automated-tests-agents#readme",
  "private": true,
  "engines": {
    "node": ">=24.11.0"
  },
  "devDependencies": {
    "@cucumber/cucumber": "13.3.0",
    "@playwright/test": "1.64.1",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/jest-runner": "10.1.1",
    "@types/jest": "^30.0.0",
    "@types/k6": "2.3.1",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "tsx": "4.23.15",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "next": "16.4.5",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
