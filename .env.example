# Copiar para .env na pasta da aplicacao gerada. Nunca versionar .env.
# fake = roteiros identificados; azure = chamada real ao deployment.
MODEL_PROVIDER=fake
PORT=3004

# Obrigatorios somente com MODEL_PROVIDER=azure.
# Usar a base da API OpenAI v1, sem /chat/completions e sem api-version.
AZURE_OPENAI_BASE_URL=https://SEU-RECURSO.openai.azure.com/openai/v1/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

AZURE_OPENAI_TIMEOUT_MS=20000
ASSISTANT_MAX_ROUNDS=4

# Aula 03 - demonstracao com PostgreSQL (copiar para .env.local; nunca versionar).
# Nao salve CONTAS_STORAGE=postgres aqui: use-o so na linha de comando do servidor.
DATABASE_URL=postgresql://lab03:lab03@127.0.0.1:5432/lab03
