SONAR_TOKEN=

# CONTAS_STORAGE=memory
CONTAS_STORAGE=postgres
DATABASE_URL=

# Copie para .env e preencha localmente. Nunca versione o .env.
# fake = ensaio roteirizado offline (não interpreta linguagem natural); azure = modelo real.
MODEL_PROVIDER=fake

# Obrigatórios apenas com MODEL_PROVIDER=azure:
# Base OpenAI v1 do recurso, terminada em /openai/v1/ (sem /models, sem /chat/completions, sem /responses, sem query)
AZURE_OPENAI_BASE_URL=
AZURE_OPENAI_API_KEY=
# Nome do deployment (usado como "model"); precisa aceitar Responses API com function calling
AZURE_OPENAI_DEPLOYMENT=

# Contas: http = lê a aplicação bancária (Next.js, só GET); memoria = fixture em memória
# (usada por testes, avaliação e "npm run smoke -- offline").
# Com http, inicie a aplicação da raiz: CONTAS_STORAGE=postgres npm run start -- --hostname 127.0.0.1 --port 3000
BANCO_BACKEND=http
BANCO_API_BASE_URL=http://127.0.0.1:3000
CHAT_CONTAS_AUTORIZADAS=123456,654321

# Opcionais (valores padrão)
PORT=3004
AZURE_OPENAI_TIMEOUT_MS=20000
BANCO_API_TIMEOUT_MS=5000
ASSISTANT_MAX_ROUNDS=4
